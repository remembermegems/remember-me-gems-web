# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Notion integration secret for the "RMG Website" integration
# (Notion settings -> My integrations -> RMG Website -> Internal Integration Secret)
NOTION_TOKEN=

# Square Sandbox credentials (developer.squareup.com -> your app -> Sandbox)
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=

# Base URL used for Square checkout success/cancel redirects (dev default is fine locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
